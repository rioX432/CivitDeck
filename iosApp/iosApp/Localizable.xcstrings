        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkpoints"
          }
        }
      }
    },
    "comfyui_model_section_diffusion_models" : {
      "comment" : "Section header in the generation form's model picker for diffusion model files",
