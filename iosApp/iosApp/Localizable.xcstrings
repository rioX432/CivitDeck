      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove"
          }
        }
      }
    },
    "settings_api_key_placeholder" : {
      "comment" : "Placeholder for the API key input field",
      "localizations" : {
