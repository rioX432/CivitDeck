      "comment" : "Button to validate and save the API key",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify"
          }
        }
      }
    },
    "settings_api_key_help" : {
      "comment" : "Helper text guiding the user to where they can get their API key",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get your key at civitai.com/user/account"
          }
        }
      }
    },
    "comfyui_onboarding_fail_cert_unconfirmed" : {
      "comment" : "Onboarding failure message when the server presents a certificate that has not been trusted yet",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server uses a certificate this device has not trusted yet. Trust it only if its fingerprint matches the one on the server."
          }
        }
      }
    },
    "comfyui_onboarding_fail_cert_changed" : {
      "comment" : "Onboarding failure message when the server's certificate differs from the one trusted before",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server's certificate differs from the one you trusted before. If you did not replace it, do not trust it: someone may be intercepting the connection."
          }
        }
      }
    },
    "comfyui_onboarding_fail_refused" : {
      "comment" : "Onboarding failure message when nothing accepts connections on the server's port",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing accepts connections on this port. On the PC, start ComfyUI with --listen (e.g. add it to run_nvidia_gpu.bat) and check the port: 8188 by default, 8000 on older ComfyUI Desktop."
          }
        }
      }
    },
    "comfyui_onboarding_fail_timeout" : {
      "comment" : "Onboarding failure message when the connection to the server timed out",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection timed out. This device and the PC must be on the same Wi-Fi network, and the PC's firewall must allow this port."
          }
        }
      }
    },
    "comfyui_onboarding_fail_auth %lld" : {
      "comment" : "Onboarding failure message when the server answers HTTP 401 or 403; the argument is the HTTP status code",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server requires sign-in (HTTP %lld). Servers behind a login are not supported yet."
          }
        }
      }
    },
    "comfyui_onboarding_fail_not_comfyui" : {
      "comment" : "Onboarding failure message when a service other than ComfyUI answered on the port",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something answered on this port, but it is not ComfyUI. Check the port."
          }
        }
      }
    },
    "comfyui_onboarding_fail_loopback" : {
      "comment" : "Onboarding failure message when the host is a loopback address such as localhost or 127.0.0.1",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "localhost, 127.0.0.1 and 0.0.0.0 point to this device. Enter the PC's local IP address instead (e.g. 192.168.1.20)."
          }
        }
      }
    },
    "comfyui_onboarding_fail_local_network_denied" : {
      "comment" : "Onboarding failure message when iOS blocks access to the local network (Wi-Fi off or Local Network permission denied)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device cannot reach the local network. Turn on Wi-Fi, or allow Local Network access for CivitDeck in Settings."
          }
        }
      }
    },
    "comfyui_onboarding_open_settings" : {
      "comment" : "Button on the onboarding failure screen that opens CivitDeck's page in the iOS Settings app",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings"
          }
        }
      }
    },
    "comfyui_onboarding_cert_fingerprint_label" : {
      "comment" : "Heading above the server certificate's SHA-256 fingerprint",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 fingerprint"
          }
        }
      }
    },
    "comfyui_onboarding_cert_fingerprint_hint" : {
      "comment" : "Hint telling the user how to compare the fingerprint with the one printed on the server",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the server, run \"openssl x509 -noout -fingerprint -sha256 -in <certificate file>\" and check that it prints the same value."
          }
        }
      }
    },
    "comfyui_onboarding_trust_certificate" : {
      "comment" : "Button that trusts the server certificate shown and saves the connection with it",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trust this certificate"
          }
        }
      }
    },
    "comfyui_review_certificate" : {
      "comment" : "ComfyUI settings action that re-tests the active self-signed connection so a changed server certificate can be confirmed",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review certificate"
          }
        }
      }
    },
    "comfyui_checkpoint" : {
      "comment" : "Label above the generation form's model picker when the server has no diffusion models",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkpoint"
          }
        }
      }
    },
    "comfyui_model" : {
      "comment" : "Label above the generation form's model picker when the server has both checkpoints and diffusion models",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model"
          }
        }
      }
    },
    "comfyui_select_placeholder" : {
      "comment" : "Placeholder shown in a generation form picker while nothing is selected",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select..."
          }
        }
      }
    },
    "comfyui_model_section_checkpoints" : {
      "comment" : "Section header in the generation form's model picker for checkpoint files",
